{
  "name": "chilecombatrec-mvc",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:front": "npm run dev --workspace=frontend",
    "dev:back": "npm run dev --workspace=backend",
    "dev": "concurrently -n BACK,FRONT -c green,cyan --kill-others-on-fail \"npm run dev:back\" \"npm run dev:front\"",
    "build": "npm run build --workspace=frontend",
    "start": "concurrently \"npm run start --workspace=backend\" \"npm run start --workspace=frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-react": "^1.59.0"
  }
}
